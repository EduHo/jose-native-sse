{
  "name": "jose-native-sse",
  "version": "0.3.0",
  "description": "Native SSE (Server-Sent Events) for React Native using TurboModules (New Architecture)",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "CHANGELOG.md",
    "src",
    "lib",
    "android",
    "ios",
    "plugin/build",
    "react-native.config.js",
    "app.plugin.js",
    "*.podspec",
    "!ios/build",
    "!android/src/test",
    "!android/build",
    "!android/.gradle",
    "!example"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example-expo/android/build example-expo/ios/build lib",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "prepare": "bob build && npm run build:plugin",
    "stress": "node stress/run.mjs",
    "stress:server": "node stress/server.mjs",
    "stress:android": "cd example-expo/android && ./gradlew :jose-native-sse:testDebugUnitTest"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "sse",
    "server-sent-events",
    "eventsource",
    "turbomodule",
    "new-architecture",
    "streaming"
  ],
  "engines": {
    "node": ">=20.19.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduHo/jose-native-sse.git"
  },
  "author": "EduHo <eduardg.geral@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EduHo/jose-native-sse/issues"
  },
  "homepage": "https://github.com/EduHo/jose-native-sse#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@expo/config-plugins": "^57.0.9",
    "@react-native/babel-preset": "0.86.2",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.2"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=8.0.0",
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "@react-native-community/netinfo": ">=9.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    }
  },
  "workspaces": [],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNNativeSseSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "directories": {
    "lib": "lib"
  },
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  }
}
